diff --git a/dlls/uxtheme/system.c b/dlls/uxtheme/system.c
index 8f963115cde..a57674adf41 100644
--- a/dlls/uxtheme/system.c
+++ b/dlls/uxtheme/system.c
@@ -1334,3 +1334,56 @@ BOOLEAN WINAPI IsDarkModeAllowedForWindow(HWND hwnd)
     FIXME("%p: stub\n", hwnd);
     return FALSE;
 }
+
+/**********************************************************************
+ *      GetImmersiveColorFromColorSetEx                   (UXTHEME.95)
+ *
+ * Undocumented immersive-color-set API. Apps such as Rhino resolve this
+ * (by name) together with GetImmersiveUserColorSetPreference and ordinals
+ * 96/100, and gate their OS dark-mode probe on all four being present. If
+ * any is missing the app falls back to a callback that re-enters the probe,
+ * recursing until the stack overflows. We return the requested color
+ * following ShouldAppsUseDarkMode so callers that inspect the application-text
+ * color see a result consistent with the user's setting: dark mode ->
+ * bright text (white), light mode -> black.
+ */
+DWORD WINAPI GetImmersiveColorFromColorSetEx(UINT color_set, UINT color_type,
+                                             BOOL ignore_high_contrast, UINT high_contrast_cache_mode)
+{
+    FIXME("(%u, %u, %d, %u): semi-stub\n", color_set, color_type,
+          ignore_high_contrast, high_contrast_cache_mode);
+
+    return ShouldAppsUseDarkMode() ? 0xffffffff : 0xff000000;
+}
+
+/**********************************************************************
+ *      GetImmersiveColorTypeFromName                     (UXTHEME.96)
+ */
+UINT WINAPI GetImmersiveColorTypeFromName(const WCHAR *name)
+{
+    FIXME("%s: stub\n", debugstr_w(name));
+    return ~0u;   /* unknown name, as on Windows; Rhino passes it through unchecked */
+}
+
+/**********************************************************************
+ *      GetImmersiveUserColorSetPreference                (UXTHEME.98)
+ */
+int WINAPI GetImmersiveUserColorSetPreference(BOOL force_check_registry, BOOL skip_check_on_fail)
+{
+    FIXME("%d, %d: stub\n", force_check_registry, skip_check_on_fail);
+    return 0;
+}
+
+/**********************************************************************
+ *      GetImmersiveColorNamedTypeByIndex                 (UXTHEME.100)
+ *
+ * Probe requires the export to exist (non-null pointer); it is never
+ * actually called on the dark-mode detection path. Returns a pointer to
+ * a wide-string pointer (the type name without its "Immersive" prefix),
+ * or NULL when the index is out of range.
+ */
+const WCHAR ** WINAPI GetImmersiveColorNamedTypeByIndex(UINT index)
+{
+    FIXME("%u: stub\n", index);
+    return NULL;
+}
